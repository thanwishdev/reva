{
  "schema": "reva.labroutes/0",
  "group": "lab-scroll",
  "viewport": { "width": 1280, "height": 800 },
  "routes": [
    {
      "id": "m01", "page": "routes/m01.html", "driver": "scroll", "engine": "chs",
      "boot": { "until": "document.readyState === 'complete' && document.getElementById('c').style.length > 0" },
      "params": {
        "default": { "o": 120, "h": 0.85 },
        "grid": [ { "o": 120, "h": 0.85 }, { "o": 0, "h": 1.0 }, { "o": 240, "h": 0.7 }, { "o": 60, "h": 0.55 }, { "o": 330, "h": 0.4 } ]
      },
      "traces": { "speed": "traces/m01.speed.json", "reversal": "traces/m01.reversal.json", "gap": "traces/m01.gap.json" },
      "regimes": ["R2", "R3", "R4", "R5"], "derived": ["R6"],
      "watch": { "selectors": ["#c"] },
      "truthClass": "scroll-map",
      "metrics": ["M01.slope", "M01.endpoints", "all.class", "all.attribution", "all.calibration", "all.confident_wrong"]
    },
    {
      "id": "m02", "page": "routes/m02.html", "driver": "scroll", "engine": "chs",
      "boot": { "until": "document.readyState === 'complete' && document.getElementById('c').style.length > 0" },
      "params": {
        "default": { "alpha": 0.18 },
        "grid": [ { "alpha": 0.08 }, { "alpha": 0.12 }, { "alpha": 0.18 }, { "alpha": 0.25 }, { "alpha": 0.4 } ],
        "writeVariants": [
          { "alpha": 0.08, "write": "q3" }, { "alpha": 0.12, "write": "q3" }, { "alpha": 0.18, "write": "q3" }, { "alpha": 0.25, "write": "q3" }, { "alpha": 0.4, "write": "q3" },
          { "alpha": 0.08, "write": "q2" }, { "alpha": 0.12, "write": "q2" }, { "alpha": 0.18, "write": "q2" }, { "alpha": 0.25, "write": "q2" }, { "alpha": 0.4, "write": "q2" }
        ],
        "writeVariantTrace": "gap"
      },
      "traces": { "speed": "traces/m02.speed.json", "reversal": "traces/m02.reversal.json", "gap": "traces/m02.gap.json" },
      "regimes": ["R2", "R3", "R4", "R5"], "derived": ["R6"],
      "watch": { "selectors": ["#c"] },
      "truthClass": "first-order smoothing",
      "metrics": ["M02.alpha", "M02.tau", "M02.settle", "M02.map", "all.class", "all.attribution", "all.calibration", "all.confident_wrong"]
    },
    {
      "id": "m03", "page": "routes/m03.html", "driver": "scroll", "engine": "chs",
      "boot": { "until": "document.readyState === 'complete' && document.getElementById('c').style.length > 0" },
      "params": {
        "default": { "aDown": 0.25, "aExit": 0.18 },
        "grid": [ { "aDown": 0.25, "aExit": 0.18 }, { "aDown": 0.1, "aExit": 0.09 }, { "aDown": 0.15, "aExit": 0.3 }, { "aDown": 0.34, "aExit": 0.12 }, { "aDown": 0.45, "aExit": 0.25 } ]
      },
      "traces": { "speed": "traces/m03.speed.json", "reversal": "traces/m03.reversal.json", "gap": "traces/m03.gap.json" },
      "regimes": ["R2", "R3", "R4", "R5"], "derived": ["R6"],
      "watch": { "selectors": ["#c"] },
      "truthClass": "asymmetric smoothing",
      "metrics": ["M03.alpha", "M03.tau", "M03.asymmetry", "all.class", "all.attribution", "all.calibration", "all.confident_wrong"]
    },
    {
      "id": "m04", "page": "routes/m04.html", "driver": "scroll", "engine": "chs",
      "boot": { "until": "document.readyState === 'complete' && document.getElementById('c').style.length > 0" },
      "params": {
        "default": { "alpha": 0.15 },
        "grid": [ { "alpha": 0.07 }, { "alpha": 0.11 }, { "alpha": 0.15 }, { "alpha": 0.26 }, { "alpha": 0.38 } ]
      },
      "traces": { "speed": "traces/m04.speed.json", "reversal": "traces/m04.reversal.json", "gap": "traces/m04.gap.json" },
      "regimes": ["R2", "R3", "R4", "R5"], "derived": ["R6"],
      "watch": { "selectors": ["#c", "#k"] },
      "truthClass": "first-order smoothing",
      "metrics": ["M04.alpha", "M04.tau", "M04.pin", "M04.hysteresis", "all.class", "all.attribution", "all.calibration", "all.confident_wrong"]
    },
    {
      "id": "m05", "page": "routes/m05.html", "driver": "wheel", "engine": "chs",
      "boot": { "until": "document.readyState === 'complete' && document.getElementById('c').style.length > 0" },
      "params": {
        "default": { "dur": 540 },
        "grid": [ { "dur": 320 }, { "dur": 430 }, { "dur": 540 }, { "dur": 780 }, { "dur": 1060 } ]
      },
      "traces": { "plain": "traces/m05.plain.json", "retarget": "traces/m05.retarget.json", "burst": "traces/m05.burst.json" },
      "regimes": ["R2", "R3", "R4", "R5"], "derived": ["R6"],
      "watch": { "selectors": ["#c"] },
      "truthClass": "tween",
      "metrics": ["M05.latch", "M05.duration", "M05.easing", "M05.retarget", "all.class", "all.attribution", "all.calibration", "all.confident_wrong"]
    },
    {
      "id": "m09", "page": "routes/m09.html", "driver": "wheel", "engine": "chs",
      "boot": { "until": "document.readyState === 'complete' && document.getElementById('c').style.length > 0" },
      "params": {
        "default": { "lerp": 0.1 },
        "grid": [ { "lerp": 0.06 }, { "lerp": 0.1 }, { "lerp": 0.15 } ]
      },
      "traces": { "speed": "traces/m09.speed.json", "reversal": "traces/m09.reversal.json", "gap": "traces/m09.gap.json" },
      "regimes": ["R2", "R3", "R4", "R5"], "derived": ["R6"],
      "watch": { "selectors": ["#c"] },
      "truthClass": "first-order smoothing",
      "vendored": "lenis@1.3.26 (MIT), vendor/lenis.mjs",
      "metrics": ["M09.law", "M09.tau", "all.class", "all.attribution", "all.calibration", "all.confident_wrong"]
    },
    {
      "id": "m09b", "page": "routes/m09b.html", "driver": "wheel", "engine": "chs",
      "boot": { "until": "document.readyState === 'complete' && document.getElementById('c').style.length > 0" },
      "params": {
        "default": { "lerp": 0.1 },
        "grid": [ { "lerp": 0.1 }, { "lerp": 0.28 } ]
      },
      "traces": { "speed": "traces/m09b.speed.json", "reversal": "traces/m09b.reversal.json", "gap": "traces/m09b.gap.json" },
      "regimes": ["R2", "R3", "R4", "R5"], "derived": ["R6"],
      "watch": { "selectors": ["#c"] },
      "truthClass": "first-order smoothing",
      "metrics": ["M09.law", "M09b.alpha", "all.class", "all.attribution", "all.calibration", "all.confident_wrong"]
    }
  ]
}
