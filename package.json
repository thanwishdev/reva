{
  "name": "reva-cli",
  "version": "0.1.0",
  "description": "Measure how any website moves and how it's designed — real springs, easing, scroll links, type and spacing, as numbers you can learn from.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thanwishdev/reva.git"
  },
  "homepage": "https://github.com/thanwishdev/reva#readme",
  "bugs": {
    "url": "https://github.com/thanwishdev/reva/issues"
  },
  "keywords": [
    "motion",
    "animation",
    "easing",
    "spring",
    "scroll",
    "design-tokens",
    "typography",
    "reverse-engineering",
    "mcp",
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "reva": "bin/reva.js"
  },
  "files": [
    "bin/",
    "src/",
    "!src/**/test/",
    "!src/**/__tests__/",
    "!src/ext/",
    "!src/skill/",
    "!src/corpus/",
    "src/corpus/gsap.js",
    "!src/lab/",
    "!src/score/",
    "!src/specimens/",
    "!src/verify/",
    "!src/analysis/fit/lab/",
    "!src/analysis/fit/cli.js",
    "!src/export/cli.js",
    "!src/freeze/{check.js,cli.js,index.js,report.js,salvage.js}",
    "!src/freeze/README.md",
    "!src/gate/{capture,causes,index,mutate,points,runtimeemit,stability,states}.js",
    "!src/libdetect/{cli.js,index.js,section.js}",
    "!src/libdetect/README.md",
    "!src/mcp/index.js",
    "!src/record/{bench,scenario}.js",
    "!src/report/v2.js",
    "!src/safety/index.js",
    "!src/static/{dembrandt.js,index.js,run.js}",
    "!src/static/README.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "LAB_PARITY=${LAB_PARITY:-quick} node --test --test-concurrency=4 --test-timeout=600000 --test-force-exit \"test/**/*.test.js\" \"fixtures/lab/*/test/*.test.js\" \"src/specimens/**/test/*.test.js\" \"src/static/__tests__/*.test.js\" \"src/freeze/test/*.test.js\"",
    "test:serial": "LAB_PARITY=${LAB_PARITY:-quick} node --test --test-concurrency=1 --test-timeout=600000 --test-force-exit \"test/**/*.test.js\" \"fixtures/lab/*/test/*.test.js\" \"src/specimens/**/test/*.test.js\" \"src/static/__tests__/*.test.js\" \"src/freeze/test/*.test.js\"",
    "test:unit": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "mcp": "node bin/reva.js mcp",
    "doctor": "node bin/reva.js doctor",
    "check:pins": "node scripts/check-pins.js",
    "prepublishOnly": "node scripts/check-pins.js && node scripts/check-public.js && node scripts/check-pack.js",
    "check:public": "node scripts/check-public.js",
    "check:pack": "node scripts/check-pack.js"
  },
  "dependencies": {
    "pixelmatch": "8.0.0",
    "playwright-core": "1.60.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "style-dictionary": "5.5.5"
  }
}
